# Copy to .env and adjust if your Postgres runs somewhere else.
PORT=4000
DATABASE_URL=postgres://portal:portal@localhost:5432/portal
JWT_SECRET=local-dev-secret-please-change-me
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173
# Sign in attempts per address per fifteen minutes. The screenshot script and a
# busy demo run need more headroom than production does.
AUTH_RATE_LIMIT=40
